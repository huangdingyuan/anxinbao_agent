# 复制为 .env 并填入真实值（.env 已被 gitignore，切勿提交）

# ---------- 应用 ----------
APP_NAME=安心保
APP_HOST=127.0.0.1
APP_PORT=8001
APP_DEBUG=true

# ---------- 认证（必填） ----------
# 生成随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-64-hex
JWT_EXPIRE_MINUTES=10080

# ---------- 数据库（与 deploy/docker-compose 默认值一致） ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=insurance123
# DB_ECHO=false
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# ---------- LLM（必填，https://platform.deepseek.com 申请） ----------
DEEPSEEK_API_KEY=sk-xxxx
CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- LangGraph Agent ----------
# false 时问答回退旧版直连 LLM 路径（不启动图与 checkpointer）
CHAT_AGENT_ENABLED=true

# ---------- 向量检索（可选，默认本地模型 + docker 中的 Milvus） ----------
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MILVUS_ENABLED=true
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kb_chunks

# ---------- 日志 ----------
LOGGING_LEVEL=INFO

# ---------- 文档解析（仅重新解析 PDF 时需要，https://mineru.net 申请） ----------
MINERU_TOKEN=
